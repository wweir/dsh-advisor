# Dependencies
node_modules/

# Build output (the host half is compiled from src/ into lib/ by tsc)
lib

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test coverage
coverage/
*.lcov
.nyc_output

# TypeScript cache
*.tsbuildinfo

# Pack output
*.tgz

# Lockfiles from other package managers (this repo standardizes on pnpm)
package-lock.json
yarn.lock

# Local env / secrets
.env
.env.*

# Caches and local scratch (the verification harness lives under .cache/,
# throwaway scripts and session markers under .scratch/)
.cache/
.scratch/
.npm
.eslintcache

# OS
.DS_Store
